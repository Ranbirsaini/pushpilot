# PushPilot Backend Configuration
PORT=5050
NODE_ENV=development

# Allowed CORS Origins (comma-separated, or * for all during local development)
# For production, specify your exact Flutter Web URL, e.g. http://localhost:8080,https://pushpilot.web.app
CORS_ORIGIN=*

# Rate Limiting (requests per 15 minutes per IP)
RATE_LIMIT_MAX=200

# Session idle timeout in minutes (in-memory cleanup)
SESSION_TIMEOUT_MINUTES=60
